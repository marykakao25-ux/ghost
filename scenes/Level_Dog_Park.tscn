[sub_resource type="GDScript" id="GDScript_setup"]
script/source = "extends Node

func _ready() -> void:
	ShapeShiftManager.unlock_form(PlayerController.Form.DOG)
	ShapeShiftManager.set_checkpoint(Vector2.ZERO)
	# После регистрации игрока директором — стартовать псом.
	call_deferred(\"_start_as_dog\")

func _start_as_dog() -> void:
	ShapeShiftManager.change_form(PlayerController.Form.DOG)
	var player: Node = ShapeShiftManager.get_player()
	if player != null and player.has_method(\"set_form\"):
		# Страховка рассинхрона: менеджер мог «запомнить» DOG раньше игрока.
		if int(player.get(\"current_form\")) != PlayerController.Form.DOG:
			player.call(\"set_form\", PlayerController.Form.DOG)
"

[sub_resource type="GDScript" id="GDScript_checkpoint"]
script/source = "extends Area2D

@export var director_path: NodePath = ^\"../LevelDirector\"

func _ready() -> void:
	body_entered.connect(_on_body_entered)

func _on_body_entered(body: Node2D) -> void:
	if not body.is_in_group(\"player\"):
		return
	var director: Node = get_node_or_null(director_path)
	if director != null and director.has_method(\"set_checkpoint\"):
		director.call(\"set_checkpoint\", global_position)
"

